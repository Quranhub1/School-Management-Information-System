# SMIS backend runtime configuration
# Copy these settings into the service manager/environment used by the API.
# Never commit real production secrets to Git.

# Required for admin seeding. If omitted, AdminSeeder generates a random password
# on first creation and records the generated credential according to deployment docs.
SEED_ADMIN_PASSWORD=replace-with-a-strong-production-password

# Required for attendance QR signing/verification. Use a long random secret and
# keep it server-side. The Security__ form is the .NET configuration equivalent.
SMIS_ATTENDANCE_QR_SECRET=replace-with-a-long-random-production-secret
Security__AttendanceQrSecret=replace-with-the-same-long-random-production-secret

# Required by the API in production.
ConnectionStrings__SchoolManagement=Host=localhost;Port=5432;Database=school_management;Username=school_management;Password=replace-me
Authentication__JwtKey=replace-with-a-long-random-jwt-signing-key

# Required in production. Use the exact trusted frontend origin(s), for example:
# AllowedOrigins__0=https://smis.example.ug
AllowedOrigins__0=replace-with-your-trusted-frontend-origin
