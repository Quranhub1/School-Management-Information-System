{
  "name": "school-management-information-system-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run copy-fonts && npm run copy-pdfmake-assets && npm run build:login-css && node scripts/check-offline-login.mjs && npm test && tsc -b && vite build",
    "build:analyze": "npm run build && node scripts/analyze-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:login-css": "npx --yes tailwindcss@3.4.17 -c tailwind.login.config.cjs -i institution-login-tailwind.css -o public/assets/css/institution-login.css",
    "predev": "npm run copy-fonts && npm run copy-pdfmake-assets && npm run build:login-css",
    "copy-fonts": "node scripts/copy-local-fonts.mjs",
    "copy-pdfmake-assets": "node scripts/copy-pdfmake-assets.mjs",
    "copy:api": "node scripts/copy-production-to-api.mjs",
    "build:lan": "npm run build && vite build --base=/ && npm run copy:api",
    "validate:api-contract": "node scripts/validate-api-contract.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "storybook test"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "tailwind-merge": "^3.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "chart.js": "4.6.1",
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "zod": "^4.6.7",
    "dexie": "4.4.7",
    "@tanstack/react-query": "5.107.1",
    "use-debounce": "10.1.1",
    "xlsx": "npm:@stackline/xlsx@1.0.10",
    "html2canvas": "1.4.1",
    "pdfmake": "0.3.13",
    "cmdk": "^1.1.1",
    "jsbarcode": "3.11.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^25.0.0",
    "typescript": "~5.8.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "@tailwindcss/vite": "^4.1.13",
    "tailwindcss": "^4.1.13",
    "@types/node": "^22.10.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "vite-plugin-checker": "^0.8.0",
    "axe-core": "^4.9.1",
    "@axe-core/playwright": "^4.9.1",
    "swagger-typescript-api": "^13.0.0",
    "openapi-types": "^12.1.3",
    "@storybook/react": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@storybook/test": "^8.4.0",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/addon-interactions": "^8.4.0",
    "@storybook/addon-links": "^8.4.0",
    "storybook": "^8.4.0",
    "storybook-dark-mode": "^4.0.0",
    "@chromatic-com/storybook": "^1.9.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
