<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:24px;background:#f4f6f9;font-family:Arial,Helvetica,sans-serif;color:#1e293b">
  <main style="max-width:620px;margin:auto;background:#fff;border:1px solid #e2e8f0;padding:28px">
    <header style="text-align:center;border-bottom:2px solid #0f172a;padding-bottom:16px">
      <h1 style="font-size:20px;margin:0;text-transform:uppercase"><%= institutionName %></h1>
      <p>Official Fee Payment Receipt</p>
    </header>
    <p style="text-align:center;color:#047857;font-weight:bold">PAYMENT VERIFIED AND LOGGED</p>
    <p>Dear Student / Parent,</p>
    <p>This message confirms that the following payment has been credited to the student's institutional ledger.</p>
    <section style="background:#f8fafc;border:1px dashed #cbd5e1;padding:18px;text-align:center">
      <small>AMOUNT RECEIVED</small><h2 style="margin:6px;color:#059669"><%= amountText %></h2>
    </section>
    <table style="width:100%;border-collapse:collapse;margin-top:18px">
      <tr><td>Student name</td><td><strong><%= receipt.studentName %></strong></td></tr>
      <tr><td>Registration number</td><td><%= receipt.studentNumber %></td></tr>
      <tr><td>Receipt number</td><td><%= receipt.receiptNumber %></td></tr>
      <tr><td>Transaction reference</td><td><%= receipt.transactionReference || "—" %></td></tr>
      <tr><td>Payment channel</td><td><%= receipt.channel %></td></tr>
      <tr><td>Payment date</td><td><%= paidAtText %></td></tr>
      <tr><td style="padding-top:12px">Remaining balance</td><td style="padding-top:12px;font-weight:bold;color:<%= receipt.balance <= 0 ? "#047857" : "#b91c1c" %>"><%= balanceText %></td></tr>
    </table>
    <footer style="margin-top:24px;border-top:1px solid #e2e8f0;padding-top:12px;text-align:center;color:#64748b;font-size:12px">
      Automated receipt from the SMIS Finance Engine.<br>
      Queries? Contact <%= institutionEmail || recipient %>
    </footer>
  </main>
</body>
</html>
