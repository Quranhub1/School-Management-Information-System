# Superset metadata database
SUPERSET_METADATA_DB_PASSWORD=replace-with-a-strong-password

# Superset application secrets. Generate with: openssl rand -base64 42
SUPERSET_SECRET_KEY=replace-with-a-long-random-secret
GUEST_TOKEN_JWT_SECRET=replace-with-a-different-long-random-secret
GUEST_TOKEN_JWT_AUDIENCE=superset

# Superset administrator used by the SMIS API to obtain guest tokens
SUPERSET_ADMIN_USERNAME=smis_guest_service
SUPERSET_ADMIN_FIRSTNAME=SMIS
SUPERSET_ADMIN_LASTNAME=Analytics
SUPERSET_ADMIN_EMAIL=admin@example.invalid
SUPERSET_ADMIN_PASSWORD=replace-with-a-strong-password

# Local listener. Keep Superset bound to localhost and expose it through HTTPS Nginx.
SUPERSET_PORT=8088
SUPERSET_WORKERS=3
CELERY_WORKERS=2

# The SMIS API must use this internal URL. On the existing single-host deployment:
# Superset: http://127.0.0.1:8088
# Public URL is configured separately in the SMIS API as Superset:PublicUrl.
